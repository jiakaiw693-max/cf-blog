{
  "name": "cf-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build.mjs --local",
    "preview": "astro preview --host 0.0.0.0",
    "preview:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "7.3.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.3",
    "pagefind": "1.5.2",
    "wrangler": "4.146.0"
  }
}
