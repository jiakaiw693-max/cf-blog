---
import { tagHref } from '../lib/posts';
interface Props { tags: string[]; filter?: boolean; }
const { tags, filter = false } = Astro.props;
---
{tags.length > 0 && <ul class="tag-list" aria-label="文章标签">{[...new Set(tags)].map(tag => <li><a href={tagHref(tag)} data-pagefind-filter={filter ? 'tag' : undefined}>{tag}</a></li>)}</ul>}
