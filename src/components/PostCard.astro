---
import TagList from './TagList.astro';
import SaveButton from './SaveButton.astro';
import Icon from './Icon.astro';
import { formatDate, postHref, readingMinutes, type Post } from '../lib/posts';
interface Props { post: Post; compact?: boolean; }
const { post, compact = false } = Astro.props;
---
<article class:list={['post-card', { 'post-card-compact': compact }]}>
  <div class="card-topline"><div class="post-meta"><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time><span class="meta-dot" aria-hidden="true">·</span><span>{readingMinutes(post)} 分钟阅读</span></div><SaveButton post={post} compact /></div>
  <h2><a href={postHref(post)}>{post.data.title}<span class="card-arrow"><Icon name="arrow" size={19} /></span></a></h2>
  {!compact && <p class="post-description">{post.data.description}</p>}
  <div class="card-bottom"><TagList tags={post.data.tags} />{post.data.example && <span class="example-label">示例</span>}</div>
</article>
