---
import TagList from './TagList.astro';
import SaveButton from './SaveButton.astro';
import CoverArt from './CoverArt.astro';
import Icon from './Icon.astro';
import { formatDate, postHref, readingMinutes, type Post } from '../lib/posts';
interface Props { post: Post; compact?: boolean; number?: number; }
const { post, compact = false, number } = Astro.props;
---
<article class:list={['post-card', { 'post-card-compact': compact }]}>
  {!compact && <a class="card-art" href={postHref(post)} tabindex="-1" aria-hidden="true"><CoverArt seed={post.id} /></a>}
  <div class="card-content"><div class="card-topline"><div class="post-meta">{number !== undefined && <span class="entry-number">N° {String(number).padStart(2, '0')}</span>}<time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time><span class="meta-dot" aria-hidden="true">/</span><span>{readingMinutes(post)} 分钟</span></div><SaveButton post={post} compact /></div>
  <h2><a href={postHref(post)}>{post.data.title}<span class="card-arrow"><Icon name="arrow" size={20} /></span></a></h2>
  {!compact && <p class="post-description">{post.data.description}</p>}
  <div class="card-bottom"><TagList tags={post.data.tags} />{post.data.example && <span class="example-label">示例</span>}</div></div>
</article>
