---
import Icon from './Icon.astro';
import { siteConfig } from '../config';
const pathname = Astro.url.pathname;
const links = [{ href: '/', label: '首页' }, { href: '/posts/', label: '文章' }, { href: '/tags/', label: '主题' }, { href: '/archives/', label: '归档' }, { href: '/about/', label: '关于' }];
const active = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<header class="site-header" data-pagefind-ignore>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.title}，首页`}><span class="brand-mark" aria-hidden="true">jk<span>✳</span></span><span class="brand-name">{siteConfig.title}<span class="brand-note">A SMALL DIGITAL GARDEN</span></span></a>
    <nav id="site-nav" class="site-nav" aria-label="主导航">
      {links.map(({ href, label }) => <a href={href} class:list={{ active: active(href) }} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
      <a class="mobile-saved-link" href="/reading-list/">稍后读 <span data-saved-count hidden>0</span></a>
    </nav>
    <div class="header-actions">
      <a href="/search/" class="icon-button search-link" aria-label="搜索文章" title="搜索文章 · Ctrl / ⌘ K"><Icon name="search" /><kbd class="search-shortcut">⌘ K</kbd></a>
      <a href="/reading-list/" class:list={['icon-button', 'saved-link', { active: active('/reading-list/') }]} aria-label="稍后读" title="稍后读" aria-current={active('/reading-list/') ? 'page' : undefined}><Icon name="bookmark" /><span class="saved-badge" data-saved-count hidden>0</span></a>
      <button class="icon-button theme-toggle" type="button" aria-label="切换显示模式" title="切换显示模式"><span class="theme-sun"><Icon name="sun" /></span><span class="theme-moon"><Icon name="moon" /></span></button>
      <button class="icon-button menu-toggle" type="button" aria-label="展开导航" aria-controls="site-nav" aria-expanded="false"><span class="menu-open-icon"><Icon name="menu" /></span><span class="menu-close-icon"><Icon name="close" /></span></button>
    </div>
  </div>
</header>
