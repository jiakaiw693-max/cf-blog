---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, getTags, type Post } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  const numbers = Object.fromEntries(posts.map((post, index) => [post.id, posts.length - index]));
  return getTags(posts).map(tag => ({ params: { tag: tag.name }, props: { tag: tag.name, posts: posts.filter(post => post.data.tags.includes(tag.name)), numbers } }));
}
interface Props { tag: string; posts: Post[]; numbers: Record<string, number>; }
const { tag, posts, numbers } = Astro.props;
---
<BaseLayout title={`标签：${tag}`}>
  <div class="reading-container page">
    <div class="breadcrumb"><a href="/tags/">全部标签</a></div>
    <header class="page-heading"><div class="eyebrow">TOPIC / {posts.length} POSTS</div><h1>{tag}</h1><p>这个主题下的 {posts.length} 篇文章。</p></header>
    <div class="posts-stack">{posts.map(post => <PostCard post={post} number={numbers[post.id]} />)}</div>
  </div>
</BaseLayout>
