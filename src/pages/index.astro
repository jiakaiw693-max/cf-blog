---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config';
import { getPosts, getTags, postHref, tagHref, formatDate, readingMinutes } from '../lib/posts';
const posts = await getPosts();
const featured = posts.find(post => post.data.featured) ?? posts[0];
const recent = posts.filter(post => post.id !== featured?.id).slice(0, 4);
const tags = getTags(posts);
---
<BaseLayout>
  <div class="container home-intro">
    <section class="home-profile" data-reveal>
      <div class="intro-label"><span class="status-dot" aria-hidden="true"></span> 一个记录想法的小站</div>
      <h1>保持好奇，<br /><span class="hero-accent">慢慢记录。<svg viewBox="0 0 310 14" aria-hidden="true"><path d="M4 8C81 0 186 1 306 9M28 12c83-7 173-9 263-6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg></span></h1>
      <p>{siteConfig.intro}<br />把零散的想法，种成可以回看的文字。</p>
      <div class="hero-actions"><a class="button button-primary" href="/posts/">开始阅读 <Icon name="arrow" size={17} /></a><a class="text-link" href="/about/">认识一下我 <span aria-hidden="true">↗</span></a></div>
      <div class="hero-stats"><span><strong>{String(posts.length).padStart(2, '0')}</strong> 篇文章</span><span><strong>{String(tags.length).padStart(2, '0')}</strong> 个主题</span><span class="garden-note"><Icon name="spark" size={15} /> 持续生长中</span></div>
    </section>
    {featured ? <article class="featured-post" data-reveal>
      <a class="featured-art" href={postHref(featured)} tabindex="-1" aria-hidden="true">
        <div class="art-grid"></div><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><span class="art-note">IDEAS TAKE ROOT.</span>
        <svg class="garden-art" viewBox="0 0 320 170" fill="none"><path d="M158 166c2-38 5-72 30-110M172 110c-12-30-45-42-77-27 12 32 46 47 77 27ZM177 100c4-32 29-51 61-43-4 28-26 48-61 43ZM184 65c-7-27 6-45 31-51 10 25-5 47-31 51Z" stroke="currentColor" stroke-width="2"/><path d="M171 110 111 89m67 11 48-34m-42 0 20-39" stroke="currentColor" stroke-width="1.5"/><circle cx="76" cy="39" r="4" fill="currentColor"/><path d="m259 120 6-14 6 14 14 6-14 6-6 14-6-14-14-6 14-6Z" stroke="currentColor" stroke-width="1.4"/></svg>
        <span class="art-coordinate">N° 01 / A NOTE TO KEEP</span><span class="art-stamp" aria-hidden="true">✳</span>
      </a>
      <div class="featured-content"><div class="featured-label"><span>{featured.data.featured ? '置顶 · 值得先读' : '最新 · 从这里开始'}</span>{featured.data.example && <span class="example-label">示例文章</span>}</div>
      <h2><a href={postHref(featured)}>{featured.data.title}</a></h2><p>{featured.data.description}</p>
      <div class="featured-bottom"><div class="post-meta"><time datetime={featured.data.publishedAt.toISOString()}>{formatDate(featured.data.publishedAt)}</time><span>·</span><span>{readingMinutes(featured)} 分钟</span></div><a class="featured-arrow" href={postHref(featured)} aria-label={`阅读：${featured.data.title}`}><Icon name="arrow" /></a></div></div>
    </article> : <section class="featured-post empty-featured"><Icon name="spark" size={44} /><h2>第一篇，从这里开始。</h2><p>暂时还没有公开的文章。</p></section>}
  </div>
  <section class="container recent-section list-grid">
    <div><div class="section-heading" data-reveal><div><span class="eyebrow">RECENT ENTRIES</span><h2>最近写下的</h2></div><a href="/posts/">查看全部 <span aria-hidden="true">↗</span></a></div>
      <div class="posts-stack" data-reveal>{recent.map(post => <PostCard post={post} />)}</div>{recent.length === 0 && <p class="empty-state">暂时没有其他文章。</p>}
      <div class="reading-invite" data-reveal><Icon name="bookmark" size={22} /><div><h3>留给稍后的一点时间</h3><p>遇见喜欢的文字，先收藏，再慢慢读。</p></div><a href="/reading-list/" aria-label="打开稍后读"><Icon name="arrow" /></a></div>
    </div>
    <aside class="side-section" aria-label="博客信息" data-reveal>
      <div class="side-panel"><div class="side-heading"><span class="eyebrow">EXPLORE</span><Icon name="spark" size={18} /></div><h2>从一个主题开始</h2>
      {tags.length > 0 ? <ul class="side-tag-list">{tags.slice(0, 8).map(tag => <li><a href={tagHref(tag.name)}><span class="topic-name">{tag.name}</span><span class="topic-count">{String(tag.count).padStart(2, '0')}</span></a></li>)}</ul> : <p>文章发布后，主题会出现在这里。</p>}<a class="quiet-link" href="/tags/">浏览所有主题 <span aria-hidden="true">↗</span></a></div>
      <div class="side-note"><span class="rss-note-icon"><Icon name="rss" size={22} /></span><h2>把更新带走</h2><p>在你喜欢的阅读器里，<br />按自己的节奏读。</p><div class="rss-actions"><a class="text-link" href="/rss.xml">RSS 订阅 ↗</a><button class="quiet-button" type="button" data-copy-path="/rss.xml">复制地址</button></div></div>
    </aside>
  </section>
</BaseLayout>
