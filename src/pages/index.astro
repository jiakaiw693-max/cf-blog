---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CoverArt from '../components/CoverArt.astro';
import ObservationArt from '../components/ObservationArt.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config';
import { getPosts, getTags, postHref, tagHref, formatDate, readingMinutes } from '../lib/posts';
const posts = await getPosts();
const featured = posts.find(post => post.data.featured) ?? posts[0];
const recent = posts.filter(post => post.id !== featured?.id).slice(0, 4);
const tags = getTags(posts);
const ordinal = (id: string) => posts.length - posts.findIndex(post => post.id === id);
---
<BaseLayout>
  <div class="container home-masthead"><span>{siteConfig.author}的个人观察手记</span><span>科技 / 学习 / 日常</span></div>
  <div class="container home-intro">
    <section class="home-profile" data-reveal>
      <div class="intro-label"><span class="label-rule" aria-hidden="true"></span> 留意世界，也整理自己 <span class="intro-index">01 / OBSERVE</span></div>
      <h1>把好奇，<br /><span class="hero-accent">写进日常。<svg viewBox="0 0 380 18" aria-hidden="true"><path d="M3 11C103 2 259 2 376 12M51 15c101-5 198-5 272-2" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg></span></h1>
      <p>{siteConfig.intro}<br />一些观察，一些尝试，还有值得留下的小事。</p>
      <div class="hero-actions"><a class="button button-primary" href="/posts/">翻开手记 <Icon name="arrow" size={18} /></a><a class="text-link" href="/about/">关于我 <span aria-hidden="true">↗</span></a></div>
      <span class="hero-footnote"><Icon name="spark" size={14} /> 不急着有答案，先把问题写下来。</span>
    </section>
    <div class="hero-illustration" data-reveal><ObservationArt /></div>
  </div>
  <div class="container journal-strip"><div class="strip-label"><span class="status-dot" aria-hidden="true"></span> 一本还在续写的手记 <span class="strip-english">ALWAYS A WORK IN PROGRESS</span></div><div class="hero-stats"><a href="/posts/"><strong>{String(posts.length).padStart(2, '0')}</strong><span>篇记录</span></a><a href="/tags/"><strong>{String(tags.length).padStart(2, '0')}</strong><span>个主题</span></a><a class="strip-rss" href="/rss.xml"><Icon name="rss" size={17} /><span>订阅更新</span></a></div></div>
  <section class="container recent-section list-grid">
    <div class="recent-main"><div class="section-heading" data-reveal><div><span class="eyebrow">02 / THE NOTEBOOK</span><h2>最近的几页</h2></div><a href="/posts/">全部文章 <span aria-hidden="true">↗</span></a></div>
      {featured ? <article class="featured-post" data-reveal>
        <a class="featured-art" href={postHref(featured)} tabindex="-1" aria-hidden="true"><CoverArt seed={featured.id} /><span class="featured-art-number">N° {String(ordinal(featured.id)).padStart(2, '0')}</span></a>
        <div class="featured-content"><div class="featured-label"><span>{featured.data.featured ? '置顶手记 / EDITOR’S PICK' : '最新手记 / LATEST ENTRY'}</span>{featured.data.example && <span class="example-label">示例</span>}</div><h2><a href={postHref(featured)}>{featured.data.title}</a></h2><p>{featured.data.description}</p><div class="featured-bottom"><div class="post-meta"><time datetime={featured.data.publishedAt.toISOString()}>{formatDate(featured.data.publishedAt)}</time><span>·</span><span>{readingMinutes(featured)} 分钟阅读</span></div><a class="featured-arrow" href={postHref(featured)} aria-label={`阅读：${featured.data.title}`}><Icon name="arrow" size={20} /></a></div></div>
      </article> : <section class="empty-featured" data-reveal><Icon name="spark" size={34} /><h2>第一篇，就从这里开始。</h2><p>暂时还没有公开的文章。</p></section>}
      <div class="posts-stack" data-reveal>{recent.map(post => <PostCard post={post} number={ordinal(post.id)} />)}</div>
      <div class="reading-invite" data-reveal><Icon name="bookmark" size={23} /><div><h3>把一页，留给下一次</h3><p>点击书签收藏，等一个空闲的时刻再读。</p></div><a href="/reading-list/" aria-label="打开稍后读"><Icon name="arrow" /></a></div>
    </div>
    <aside class="side-section" aria-label="博客信息" data-reveal>
      <div class="side-panel"><div class="side-heading"><span class="eyebrow">03 / INDEX</span><Icon name="spark" size={19} /></div><h2>从哪里开始？</h2><p class="side-intro">挑一个此刻感兴趣的话题。</p>{tags.length > 0 ? <ul class="side-tag-list">{tags.slice(0, 8).map(tag => <li><a href={tagHref(tag.name)}><span class="topic-name">{tag.name}</span><span class="topic-count">{String(tag.count).padStart(2, '0')}</span><span class="topic-arrow" aria-hidden="true">↗</span></a></li>)}</ul> : <p>文章发布后，主题会出现在这里。</p>}<a class="quiet-link" href="/tags/">浏览所有主题 <span aria-hidden="true">→</span></a></div>
      <div class="side-note"><span class="eyebrow">LET THE WORDS FIND YOU</span><span class="rss-note-icon"><Icon name="rss" size={23} /></span><h2>把更新带走。</h2><p>没有算法催促，<br />按自己的节奏阅读。</p><div class="rss-actions"><a class="text-link" href="/rss.xml">RSS 订阅 ↗</a><button class="quiet-button" type="button" data-copy-path="/rss.xml">复制地址</button></div></div>
    </aside>
  </section>
</BaseLayout>
