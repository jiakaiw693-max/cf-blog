---
import PostsListing from '../../../components/PostsListing.astro';
import { getPosts, type Post } from '../../../lib/posts';
import { siteConfig } from '../../../config';
export async function getStaticPaths() {
  const allPosts = await getPosts();
  const totalPages = Math.ceil(allPosts.length / siteConfig.postsPerPage);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const pageNumber = index + 2;
    return { params: { page: String(pageNumber) }, props: { posts: allPosts.slice((pageNumber - 1) * siteConfig.postsPerPage, pageNumber * siteConfig.postsPerPage), allPosts, pageNumber, totalPages } };
  });
}
interface Props { posts: Post[]; allPosts: Post[]; pageNumber: number; totalPages: number; }
---
<PostsListing {...Astro.props} />
