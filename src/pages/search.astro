---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getPosts, getTags } from '../lib/posts';
const posts = await getPosts();
const tags = getTags(posts);
---
<BaseLayout title="搜索文章" noIndex>
  <div class="reading-container page search-page" data-post-count={posts.length}>
    <header class="page-heading"><div class="eyebrow">FIND SOMETHING WORTH READING</div><h1>找一篇，慢慢读。</h1><p>从一个关键词，找到你感兴趣的想法。</p></header>
    <form id="search-form" role="search"><label class="search-box" for="search-input"><Icon name="search" size={22} /><span class="sr-only">文章关键词</span><input id="search-input" type="search" name="q" placeholder="搜索标题、正文或一个想法…" autocomplete="off" maxlength="200" /><button type="button" id="search-clear" class="search-clear" aria-label="清除搜索" hidden><Icon name="close" size={18} /></button></label>
      <div class="search-options"><label>主题<select id="search-tag" name="tag"><option value="">全部主题</option>{tags.map(tag => <option value={tag.name}>{tag.name}</option>)}</select></label><label>排序<select id="search-sort" name="sort"><option value="relevance">最相关</option><option value="newest">最新发布</option><option value="oldest">最早发布</option></select></label></div>
    </form>
    <div class="search-suggestions" id="search-suggestions"><span>试着找找</span>{tags.slice(0, 4).map(tag => <button class="suggestion-chip" type="button" data-search-query={tag.name}>{tag.name} ↗</button>)}</div>
    <noscript><p class="empty-state">搜索需要启用 JavaScript。你也可以查看 <a href="/posts/">全部文章</a>。</p></noscript>
    <p class="search-status" id="search-status" role="status" aria-live="polite">输入关键词，或选择一个主题。</p>
    <ol class="search-results" id="search-results" aria-label="搜索结果"></ol>
    <button class="button search-more" id="search-more" type="button" hidden>显示更多结果</button>
  </div>
  <script type="module" src="/search.js" is:inline></script>
</BaseLayout>
